# =============================================================
# Hajri Card - WhatsApp Business & Firebase Backend Configuration
# =============================================================

# Server Port
PORT=8080

# Cryptographic HMAC session signing secret (e.g., 32+ character random string)
SESSION_SECRET=your-random-32-byte-hex-session-secret-here

# -------------------------------------------------------------
# Meta WhatsApp Business Cloud API Configuration
# Get these from Meta for Developers -> App Dashboard -> WhatsApp -> API Setup
# -------------------------------------------------------------
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here
META_WA_ACCESS_TOKEN=your_system_user_permanent_access_token_here
META_WA_TEMPLATE_NAME=hajri_auth_code
META_WA_TEMPLATE_LANG=en_US

# -------------------------------------------------------------
# Firebase Admin SDK Configuration
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
